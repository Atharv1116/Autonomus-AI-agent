# ============================================
# Autonomous Data Analyst Agent
# Environment Configuration
# ============================================

# --- Database Configuration ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/analyst_db
# For MySQL: mysql+pymysql://user:password@localhost:3306/analyst_db
# For SQLite: sqlite:///./data/analyst.db

# --- LLM Provider (nvidia_nim | openai | groq | ollama) ---
LLM_PROVIDER=nvidia_nim

# --- NVIDIA NIM Configuration ---
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- OpenAI Configuration ---
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# --- Groq Configuration ---
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-70b-versatile

# --- Ollama Configuration ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Application Settings ---
LOG_LEVEL=INFO
MAX_QUERY_ROWS=10000
QUERY_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=3600
MAX_RETRIES=3

# --- Streamlit ---
STREAMLIT_THEME=dark
